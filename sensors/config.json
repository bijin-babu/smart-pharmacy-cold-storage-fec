{
  "device_id": "pharmacy-fridge-01",
  "sensors": [
    {
      "type": "temperature",
      "unit": "C",
      "normal_range": [2.0, 8.0],
      "step": 0.4,
      "anomaly_chance": 0.04,
      "anomaly_range": [9.0, 16.0],
      "anomaly_duration_ticks": 5,
      "frequency_sec": 2
    },
    {
      "type": "humidity",
      "unit": "%",
      "normal_range": [40.0, 60.0],
      "step": 1.5,
      "anomaly_chance": 0.03,
      "anomaly_range": [65.0, 85.0],
      "anomaly_duration_ticks": 4,
      "frequency_sec": 5
    },
    {
      "type": "door_status",
      "unit": "bool",
      "normal_value": 0,
      "anomaly_chance": 0.03,
      "anomaly_value": 1,
      "anomaly_duration_ticks": 6,
      "frequency_sec": 3
    },
    {
      "type": "battery_level",
      "unit": "%",
      "start_value": 100.0,
      "drain_per_tick": 0.15,
      "recharge_chance": 0.01,
      "frequency_sec": 10
    },
    {
      "type": "vibration",
      "unit": "g",
      "normal_range": [0.0, 0.2],
      "step": 0.05,
      "anomaly_chance": 0.03,
      "anomaly_range": [1.0, 3.0],
      "anomaly_duration_ticks": 2,
      "frequency_sec": 4
    }
  ],
  "fog": {
    "dispatch_interval_sec": 10,
    "batch_size_max": 50,
    "thresholds": {
      "temperature": {"min": 2.0, "max": 8.0},
      "humidity": {"max": 65.0},
      "door_status": {"max_open_sec": 20},
      "battery_level": {"min": 20.0},
      "vibration": {"max": 1.0}
    }
  },
  "aws": {
  "region": "us-east-1",
  "telemetry_queue_url": "https://sqs.us-east-1.amazonaws.com/541759722771/coldchain-telemetry-queue",
  "alerts_queue_url": "https://sqs.us-east-1.amazonaws.com/541759722771/coldchain-alerts-queue"
  }
}
